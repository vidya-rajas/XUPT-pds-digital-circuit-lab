define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {J18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:rst} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst} {PAP_IO_LOC} {J14}
define_attribute {p:rst} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst} {PAP_IO_NONE} {TRUE}
define_attribute {p:q3} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:q3} {PAP_IO_LOC} {H16}
define_attribute {p:q3} {PAP_IO_VCCIO} {3.3}
define_attribute {p:q3} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:q3} {PAP_IO_DRIVE} {4}
define_attribute {p:q3} {PAP_IO_NONE} {TRUE}
define_attribute {p:q3} {PAP_IO_SLEW} {SLOW}
define_attribute {p:q2} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:q2} {PAP_IO_LOC} {J16}
define_attribute {p:q2} {PAP_IO_VCCIO} {3.3}
define_attribute {p:q2} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:q2} {PAP_IO_DRIVE} {4}
define_attribute {p:q2} {PAP_IO_NONE} {TRUE}
define_attribute {p:q2} {PAP_IO_SLEW} {SLOW}
define_attribute {p:q1} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:q1} {PAP_IO_LOC} {K18}
define_attribute {p:q1} {PAP_IO_VCCIO} {3.3}
define_attribute {p:q1} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:q1} {PAP_IO_DRIVE} {4}
define_attribute {p:q1} {PAP_IO_NONE} {TRUE}
define_attribute {p:q1} {PAP_IO_SLEW} {SLOW}
define_attribute {p:q0} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:q0} {PAP_IO_LOC} {N15}
define_attribute {p:q0} {PAP_IO_VCCIO} {3.3}
define_attribute {p:q0} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:q0} {PAP_IO_DRIVE} {4}
define_attribute {p:q0} {PAP_IO_NONE} {TRUE}
define_attribute {p:q0} {PAP_IO_SLEW} {SLOW}
create_clock -name {clk} {clk} -period {20.000} -waveform {0.000 10.000} -add
