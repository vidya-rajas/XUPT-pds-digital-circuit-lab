define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {J18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:clr_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clr_n} {PAP_IO_LOC} {K15}
define_attribute {p:clr_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clr_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clr_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:qa} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:qa} {PAP_IO_LOC} {G16}
define_attribute {p:qa} {PAP_IO_VCCIO} {3.3}
define_attribute {p:qa} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:qa} {PAP_IO_DRIVE} {4}
define_attribute {p:qa} {PAP_IO_NONE} {TRUE}
define_attribute {p:qa} {PAP_IO_SLEW} {SLOW}
define_attribute {p:qb} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:qb} {PAP_IO_LOC} {H16}
define_attribute {p:qb} {PAP_IO_VCCIO} {3.3}
define_attribute {p:qb} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:qb} {PAP_IO_DRIVE} {4}
define_attribute {p:qb} {PAP_IO_NONE} {TRUE}
define_attribute {p:qb} {PAP_IO_SLEW} {SLOW}
define_attribute {p:qc} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:qc} {PAP_IO_LOC} {J16}
define_attribute {p:qc} {PAP_IO_VCCIO} {3.3}
define_attribute {p:qc} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:qc} {PAP_IO_DRIVE} {4}
define_attribute {p:qc} {PAP_IO_NONE} {TRUE}
define_attribute {p:qc} {PAP_IO_SLEW} {SLOW}
define_attribute {p:qd} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:qd} {PAP_IO_LOC} {K18}
define_attribute {p:qd} {PAP_IO_VCCIO} {3.3}
define_attribute {p:qd} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:qd} {PAP_IO_DRIVE} {4}
define_attribute {p:qd} {PAP_IO_NONE} {TRUE}
define_attribute {p:qd} {PAP_IO_SLEW} {SLOW}
create_clock -name {clk} {clk} -period {20.000} -waveform {0.000 10.000} -add
